# Insecure defaults for local use. Before the first start of an install that
# other people can reach, change POSTGRES_PASSWORD and LOCAL_KMS_ENCRYPTION_KEY.
# Gatana cannot change the encryption key after the first start.

# --- Read by Gatana ---

# The address people open. For a VM: http://192.168.1.10:8080
PUBLIC_URL=http://localhost:8080

# Postgres is reachable only from the Gatana container.
POSTGRES_PASSWORD=gatana

# Encrypts stored credentials, so a database backup alone cannot expose them.
# Generate a real key with: openssl rand -base64 32
KMS_PROVIDER=local
LOCAL_KMS_ENCRYPTION_KEY=Q2hhbmdlTWVCZWZvcmVGaXJzdFN0YXJ0MDAwMDAwMDA=

# Optional. Any other Gatana setting works here too, for example:
# LICENSE_KEY=
# EMAIL_PROVIDER=smtp
# SMTP_HOST=
# OPTOUT_NO_LICENSE_EMAIL_SHARE=true

# --- Read by Compose only ---

# The published port. Keep it equal to the port in PUBLIC_URL.
GATANA_PORT=8080
